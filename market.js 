// MAITA NOVA IA V1 - Mercado

async function actualizarMercado() {
  try {
    const symbols = ["BTCUSDT", "ETHUSDT", "BNBUSDT"];

    const respuestas = await Promise.all(
      symbols.map(s =>
        fetch(`https://api.binance.com/api/v3/ticker/price?symbol=${s}`)
          .then(r => r.json())
      )
    );

    document.getElementById("btc").textContent =
      "$" + Number(respuestas[0].price).toLocaleString();

    document.getElementById("eth").textContent =
      "$" + Number(respuestas[1].price).toLocaleString();

    document.getElementById("bnb").textContent =
      "$" + Number(respuestas[2].price).toLocaleString();

  } catch (e) {
    document.getElementById("btc").textContent = "Error";
    document.getElementById("eth").textContent = "Error";
    document.getElementById("bnb").textContent = "Error";
  }
}

actualizarMercado();
setInterval(actualizarMercado, 15000);