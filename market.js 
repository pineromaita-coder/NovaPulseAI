// MAITA NOVA IA - Mercado V3

async function actualizarMercado() {
  try {
    const respuesta = await fetch(
      "https://api.coingecko.com/api/v3/simple/price?ids=bitcoin,ethereum,binancecoin&vs_currencies=usd",
      { cache: "no-store" }
    );

    if (!respuesta.ok) throw new Error("API");

    const datos = await respuesta.json();

    document.getElementById("btc").textContent =
      "$" + datos.bitcoin.usd.toLocaleString("en-US");

    document.getElementById("eth").textContent =
      "$" + datos.ethereum.usd.toLocaleString("en-US");

    document.getElementById("bnb").textContent =
      "$" + datos.binancecoin.usd.toLocaleString("en-US");

  } catch (e) {
    document.getElementById("btc").textContent = "Sin conexión";
    document.getElementById("eth").textContent = "Sin conexión";
    document.getElementById("bnb").textContent = "Sin conexión";
    console.log("Market:", e);
  }
}

window.addEventListener("load", () => {
  actualizarMercado();
  setInterval(actualizarMercado, 30000);
});