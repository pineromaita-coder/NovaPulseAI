const core=document.querySelector(".arc-core");

document.addEventListener("pointermove",e=>{

const x=(e.clientX/window.innerWidth-.5)*25;
const y=(e.clientY/window.innerHeight-.5)*25;

core.style.transform=`translate(${x}px,${y}px)`;

});

function saludo(){

const synth=window.speechSynthesis;

const voz=new SpeechSynthesisUtterance(
"Bienvenido operador. Nova Pulse AI iniciado."
);

voz.lang="es-ES";

synth.speak(voz);

}