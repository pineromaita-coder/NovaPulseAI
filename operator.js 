const btn=document.getElementById("operatorOpen");

const panel=document.createElement("div");

panel.id="operatorPanel";

panel.innerHTML=`
<div class="opbox">

<button id="cerrar">✕</button>

<h2>MAITACORE</h2>

<p>Operador David autorizado</p>

<div class="scan"></div>

</div>
`;

document.body.appendChild(panel);

const css=document.createElement("style");

css.textContent=`
#operatorPanel{
position:fixed;
inset:0;
background:rgba(0,8,18,.95);
display:flex;
justify-content:center;
align-items:center;
opacity:0;
pointer-events:none;
transition:.3s;
z-index:3000;
}

#operatorPanel.show{
opacity:1;
pointer-events:auto;
}

.opbox{
width:90%;
max-width:330px;
background:#07131d;
border:1px solid rgba(0,212,255,.3);
border-radius:24px;
padding:24px;
text-align:center;
position:relative;
}

#cerrar{
position:absolute;
top:14px;
right:16px;
background:none;
border:none;
color:white;
font-size:22px;
}

.scan{
width:140px;
height:140px;
margin:20px auto;
border-radius:50%;
border:2px solid cyan;
box-shadow:0 0 30px cyan;
animation:pulse 2s infinite;
}
`;

document.head.appendChild(css);

btn.onclick=()=>panel.classList.add("show");

document.getElementById("cerrar").onclick=()=>panel.classList.remove("show");